# ============================================================================
# Pakistan Business Compliance AI — Environment Variables Template
# Copy this file to .env for local development (never commit real secrets).
# ============================================================================

# --- AI Providers (Server-Side Only) ----------------------------------------
# Google Gemini API key (primary LLM + gemini-embedding-2 vector indexing + OCR)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional OpenRouter API key (used as automatic fallback on Gemini quota/outages or as primary when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# OpenRouter model slug (e.g. "openrouter/free" or "meta-llama/llama-3.3-70b-instruct:free")
OPENROUTER_MODEL="openrouter/free"

# AI routing strategy: "auto" (Gemini primary -> OpenRouter fallback), "gemini", or "openrouter"
AI_PROVIDER="auto"

# Primary Gemini model identifiers
LLM_MODEL="gemini-4-hydrogen"
EMBEDDING_MODEL="gemini-embedding-2"

# Cost & latency guardrails for server-side AI generation
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_CONTEXT_CHARS="16000"
AI_MAX_OUTPUT_TOKENS="1800"

# --- Server & Networking ----------------------------------------------------
# Public URL where the app is hosted (Cloud Run, Render, or local URL)
APP_URL="http://localhost:3000"

# Comma-separated list of allowed frontend origins (e.g. https://your-app.vercel.app)
CORS_ORIGINS=""

# Server HTTP port (Cloud Run / Render inject PORT automatically; defaults to 3000)
PORT="3000"

# Frontend API base URL (leave blank for same-origin Cloud Run / AI Studio; set to backend URL when hosting frontend on Vercel)
VITE_API_BASE_URL=""

# --- Database & Document Storage --------------------------------------------
# Local SQLite RAG + FTS5 index path (persistent disk recommended on Render/VM; Cloud Run uses ephemeral disk unless migrated)
DATABASE_PATH="./data/compliance.db"

# Private filesystem folder for uploaded regulatory source documents
STORAGE_PATH="./data/uploads"

# Optional PostgreSQL / pgvector connection string for managed persistent production migration
DATABASE_URL=""

# --- Governance & Access Control --------------------------------------------
# Optional comma-separated list of fallback verified administrator emails (primary RBAC is Firestore /admins/{uid})
ADMIN_EMAILS="admin@example.com"

