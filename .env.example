# GEMINI_API_KEY: Automatically injected at runtime by Google AI Studio Secrets for Gemini RAG inference and embeddings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected at runtime by Google AI Studio.
APP_URL="http://localhost:3000"

# DATABASE_PATH: Local filesystem path (NOT an API key) for the official regulatory document RAG/FTS5 index.
DATABASE_PATH="./data/compliance.db"

# STORAGE_PATH: Private filesystem folder (NOT an API key) for uploaded regulatory source PDFs/files.
STORAGE_PATH="./data/uploads"

# LLM / Embedding model configuration (safe defaults built in)
LLM_MODEL="gemini-4-hydrogen"
EMBEDDING_MODEL="gemini-embedding-2"

# Optional comma-separated additional verified administrator emails
ADMIN_EMAILS=""
